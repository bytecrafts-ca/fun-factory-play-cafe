# Ovatu public minisite (customer-facing — NOT ovatu.app/minisite which is staff login)
NEXT_PUBLIC_OVATU_BOOK_URL=https://the-fun-factory.book.app/book-now
NEXT_PUBLIC_OVATU_TICKETS_URL=https://the-fun-factory.book.app/timetable
# Use /book once the Book tab is enabled in Ovatu Manager
NEXT_PUBLIC_OVATU_PARTIES_URL=https://the-fun-factory.book.app/book-now

# Fall 2026 party promo (10% off new online party bookings, Oct 1 to Dec 31)
# Create in Ovatu Manager → Promo codes. New bookings only. Party packages only.
# Booking date AND party date must be on or before Dec 31, 2026.
# Marketing link (auto-applies discount): edit promo → Marketing tab → copy link
# NEXT_PUBLIC_OVATU_PARTY_PROMO_URL=
# Or promo code for customers to enter at checkout (Voucher/Gift Card field)
# NEXT_PUBLIC_OVATU_PARTY_PROMO_CODE=

# Waiver form (defaults to Jotform if unset)
# NEXT_PUBLIC_WAIVER_URL=https://form.jotform.com/261257549756066

# Littles & Lattés Café Google reviews (separate from Fun Factory listing)
# NEXT_PUBLIC_LITTLES_GOOGLE_REVIEWS_URL=
# NEXT_PUBLIC_LITTLES_GOOGLE_WRITE_REVIEW_URL=

# Square Loyalty (server-only — add in Vercel project settings, never commit real tokens)
# Create an app at https://developer.squareup.com with LOYALTY_READ + LOYALTY_WRITE + CUSTOMERS_WRITE
# SQUARE_ACCESS_TOKEN=
# SQUARE_ENVIRONMENT=production
# Optional: live Google reviews on the home page (falls back to featured reviews if unset)
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=

# SEO verification (optional — add codes from Search Console / Bing Webmaster)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google Ads (gtag) — defaults to Fun Factory account if unset
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18425793193
# Purchase conversion — fire via trackGoogleAdsPurchaseConversion() on thank-you pages only
# NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_CONVERSION=AW-18425793193/PAR9CJmT3uwcEKmVjdJE
# Contact conversion (Littles & Lattés) — fires on café phone/email/contact clicks + Café Menu form
# NEXT_PUBLIC_GOOGLE_ADS_CONTACT_CONVERSION=AW-18425793193/u82bCN3-zu0cEKmVjdJE
# Click conversions for outbound booking links (Ovatu party / Square tickets). Leave unset to skip.
# Create in Google Ads → Goals → Conversions → Website → manual, then paste the send_to value.
# NEXT_PUBLIC_GOOGLE_ADS_PARTY_CLICK_CONVERSION=AW-18425793193/XXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_TICKET_CLICK_CONVERSION=AW-18425793193/XXXXXXXX

# Analytics (optional, each loads only when set)
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_ID=
